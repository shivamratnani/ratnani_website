# GitHub — fine-grained PAT, read-only, scope: read:user
GITHUB_TOKEN=

# Spotify — create an app at https://developer.spotify.com/dashboard
# Get the refresh token once with:  pnpm spotify:auth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Redis — provisioned by the Vercel Upstash integration, which injects these
# names (not UPSTASH_*). Pull them locally with: vercel env pull
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=shiv@ratnani.org

# Shared with the GitHub Actions cron. Generate with: openssl rand -hex 32
# Use DIFFERENT values for Preview and Production.
CRON_SECRET=
